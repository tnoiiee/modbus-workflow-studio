* text=auto
*.mjs text eol=lf
.githooks/** text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary

# Runtime state must never be versioned. If a file is accidentally added before
# the ignore rule is noticed, suppress textual diffs to avoid re-exposing its contents.
server/data/** -diff
data/** -diff
